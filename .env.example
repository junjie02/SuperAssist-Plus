# --- Model ---
SUPERASSIST_MODEL_PROVIDER=openai
SUPERASSIST_MODEL=gpt-4o-mini
SUPERASSIST_API_KEY=
SUPERASSIST_BASE_URL=https://api.openai.com/v1
# SUPERASSIST_TEMPERATURE=
# SUPERASSIST_MAX_TOKENS=
# GPT-5.6: none, low, medium, high, xhigh, max (Feishu can override per chat with /effort)
SUPERASSIST_REASONING_EFFORT=medium
# Applies to the main model, fallbacks, memory models, and subagents.
# Set false only for compatible gateways that do not implement /responses.
SUPERASSIST_USE_RESPONSES_API=true
# Optional ordered lead-agent fallbacks. Store real keys only in your local
# environment or secret manager. Each base URL must include its OpenAI-compatible /v1 prefix.
SUPERASSIST_CLAUDE_FALLBACK_MODEL=claude-opus-5
SUPERASSIST_CLAUDE_FALLBACK_API_KEY=
SUPERASSIST_CLAUDE_FALLBACK_BASE_URL=https://code.mmkg.cloud/v1
SUPERASSIST_DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash
SUPERASSIST_DEEPSEEK_FALLBACK_API_KEY=
SUPERASSIST_DEEPSEEK_FALLBACK_BASE_URL=
# GPT-5.6 only: cache stable prompt/history prefixes and exclude dynamic turn context.
SUPERASSIST_PROMPT_CACHE_EXPLICIT_ENABLED=true
# Append the final provider payload for each model request to
# <SUPERASSIST_DATA_DIR>/logs/model-input.jsonl (rotated at the configured size).
SUPERASSIST_MODEL_INPUT_LOG_ENABLED=false
SUPERASSIST_MODEL_INPUT_LOG_MAX_BYTES=52428800

# --- Tools ---
SUPERASSIST_ENABLE_TOOLS=false
SUPERASSIST_TOOL_NETWORK_ENABLED=true
SUPERASSIST_TOOL_SHELL_ENABLED=false
SUPERASSIST_MAX_TOOL_CALLS=8
# Optional dedicated OpenAI-compatible endpoint for the generate_image tool.
# Blank values reuse SUPERASSIST_API_KEY and SUPERASSIST_BASE_URL.
SUPERASSIST_IMAGE_GENERATION_MODEL=gpt-image-2
SUPERASSIST_IMAGE_GENERATION_API_KEY=
SUPERASSIST_IMAGE_GENERATION_BASE_URL=

# --- Subagents ---
SUPERASSIST_SUBAGENTS_ENABLED=true
SUPERASSIST_AGENT_TEAMS_ENABLED=true
SUPERASSIST_SUBAGENT_MAX_CONCURRENT=3
SUPERASSIST_SUBAGENT_TIMEOUT_SECONDS=900
SUPERASSIST_SUBAGENT_MAX_TURNS=20
SUPERASSIST_AGENTS_DIR=config/agents

# --- Memory ---
SUPERASSIST_MEMORY_LLM_WRITER_ENABLED=true
# Memory Updater and short-memory compactor use this independent OpenAI-compatible client.
SUPERASSIST_MEMORY_MODEL=deepseek-v4-flash
# Blank values fall back to SUPERASSIST_API_KEY and SUPERASSIST_BASE_URL.
SUPERASSIST_MEMORY_API_KEY=
SUPERASSIST_MEMORY_BASE_URL=
# SUPERASSIST_MEMORY_MAX_TOKENS=
SUPERASSIST_MEMORY_DEBOUNCE_SECONDS=30.0
SUPERASSIST_MEMORY_TOP_K=12
SUPERASSIST_MEMORY_CANDIDATE_POOL_SIZE=150
SUPERASSIST_MEMORY_READ_USE_PPR=true
SUPERASSIST_MEMORY_READ_ENTRY_POINTS=10
SUPERASSIST_MEMORY_READ_MAX_DEPTH=3
SUPERASSIST_MEMORY_READ_BFS_WEIGHT=0.6
SUPERASSIST_MEMORY_READ_PPR_WEIGHT=0.4
SUPERASSIST_MEMORY_READ_BFS_DECAY=0.7
# Structured retrieval timings; records hashes and counts, never query or memory text.
SUPERASSIST_MEMORY_RETRIEVAL_LOG_ENABLED=true
SUPERASSIST_MEMORY_RETRIEVAL_LOG_MAX_BYTES=20971520
SUPERASSIST_MEMORY_REINFORCE_SIMILARITY=0.85
SUPERASSIST_MEMORY_CONCEPT_MERGE_SIMILARITY=0.85
SUPERASSIST_MEMORY_COMPLETION_SIMILARITY=0.30
SUPERASSIST_MEMORY_COMPLETION_TOP_K=5
SUPERASSIST_MEMORY_DECAY_LAMBDA=0.005
SUPERASSIST_MEMORY_EDGE_DELETE_THRESHOLD=0.15

# --- Short memory ---
SUPERASSIST_SHORT_MEMORY_TOKEN_LIMIT=80000
SUPERASSIST_SHORT_MEMORY_KEEP_RECENT_TURNS=30
SUPERASSIST_SHORT_MEMORY_SUMMARY_TARGET_TOKENS=6000

# --- Skills ---
SUPERASSIST_SKILL_ACTIVE_TTL_SECONDS=300

# --- Embedding ---
SUPERASSIST_EMBEDDING_PROVIDER=bge
SUPERASSIST_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
SUPERASSIST_EMBEDDING_DEVICE=cpu

# --- Hybrid RAG knowledge base (FAISS dense + SQLite FTS5 BM25) ---
SUPERASSIST_RAG_MAX_FILE_SIZE_MB=25
SUPERASSIST_RAG_MAX_FILES_PER_BATCH=20
SUPERASSIST_RAG_CHUNK_TARGET_TOKENS=384
SUPERASSIST_RAG_CHUNK_MAX_TOKENS=480
SUPERASSIST_RAG_CHUNK_OVERLAP_TOKENS=64
SUPERASSIST_RAG_CANDIDATE_TOP_K=50
SUPERASSIST_RAG_CHUNK_TOP_K=10
SUPERASSIST_RAG_RRF_K=60
SUPERASSIST_RAG_CONTEXT_MAX_TOKENS=5000
SUPERASSIST_RAG_ACCUMULATED_EVIDENCE_MAX_TOKENS=8000
SUPERASSIST_RAG_STAGNANT_SEARCH_LIMIT=2

# --- Persistence ---
SUPERASSIST_DATA_DIR=.superassist
SUPERASSIST_ADMIN_USERNAMES=painting

# --- Database (empty uses SQLite) ---
SUPERASSIST_DB_URL=

# --- Redis runtime state (optional; disabled keeps local/SQLite fallbacks) ---
SUPERASSIST_REDIS_ENABLED=false
SUPERASSIST_REDIS_URL=redis://127.0.0.1:6379/0
SUPERASSIST_REDIS_PREFIX=superassist
# Fail startup instead of degrading to local state when Redis is unavailable.
SUPERASSIST_REDIS_REQUIRED=false
SUPERASSIST_REDIS_SOCKET_TIMEOUT_SECONDS=1.0
SUPERASSIST_REDIS_TASK_TTL_SECONDS=86400
SUPERASSIST_REDIS_SHORT_MEMORY_TTL_SECONDS=3600
SUPERASSIST_REDIS_RECALL_TTL_SECONDS=120
# 0 disables the per-user inbound API counter.
SUPERASSIST_API_RATE_LIMIT_PER_MINUTE=0

# --- Go Server ---
SUPERASSIST_GO_PORT=8080
SUPERASSIST_PYTHON_HOST=http://127.0.0.1:8765

# --- JWT Auth ---
SUPERASSIST_JWT_SECRET=
SUPERASSIST_JWT_EXPIRY_HOURS=48

# --- Feishu ---
SUPERASSIST_FEISHU_APP_ID=
SUPERASSIST_FEISHU_APP_SECRET=
SUPERASSIST_FEISHU_DOMAIN=https://open.feishu.cn
# Browser URL prefix for formula answers published as Feishu cloud documents.
SUPERASSIST_FEISHU_DOC_URL_BASE=https://feishu.cn/docx
SUPERASSIST_FEISHU_ALLOWED_OPEN_IDS=
SUPERASSIST_FEISHU_MENTION_ONLY=true
SUPERASSIST_FEISHU_ACTIVE_SESSION_SECONDS=180
# After an explicit group mention, collect both text and images until the
# conversation is quiet for 1.5s, bounded by a 6s hard deadline.
SUPERASSIST_FEISHU_ACTIVATION_DEBOUNCE_SECONDS=1.5
SUPERASSIST_FEISHU_ACTIVATION_MAX_WAIT_SECONDS=6.0
SUPERASSIST_FEISHU_MAX_IMAGES_PER_ACTIVATION=12
# Original images always go directly to the main model. Local OCR is optional, untrusted context.
# The main model also appends a question-relevant <ImageDescription> to its answer for later turns.
SUPERASSIST_FEISHU_IMAGE_OCR_ENABLED=true
SUPERASSIST_FEISHU_IMAGE_OCR_MAX_CHARS=12000
# Sliding TTL: each accepted follow-up keeps the latest full image set in model context.
SUPERASSIST_FEISHU_IMAGE_CONTEXT_TTL_SECONDS=180

# --- Shenlun official-media daily brief ---
# Scans each source's latest pages first; no topic keywords are configured.
SUPERASSIST_DAILY_BRIEF_ENABLED=false
SUPERASSIST_DAILY_BRIEF_TIMES=07:45,19:45
SUPERASSIST_DAILY_BRIEF_TIMEZONE=Asia/Shanghai
# Comma-separated Feishu chat IDs that receive scheduled cards. Use /brief for a manual current-chat preview.
SUPERASSIST_DAILY_BRIEF_FEISHU_CHAT_IDS=
SUPERASSIST_DAILY_BRIEF_SOURCE_FILE=config/official_media.toml
SUPERASSIST_DAILY_BRIEF_PROMPT_FILE=prompts/shenlun_daily_brief.md
SUPERASSIST_DAILY_BRIEF_LOOKBACK_HOURS=24
SUPERASSIST_DAILY_BRIEF_CATCH_UP_MINUTES=10
SUPERASSIST_DAILY_BRIEF_MAX_CANDIDATES=80
SUPERASSIST_DAILY_BRIEF_MIN_SOURCES=3
# Uses the independent memory-provider credentials when API key/base URL are blank.
SUPERASSIST_DAILY_BRIEF_MODEL=deepseek-v4-flash
SUPERASSIST_DAILY_BRIEF_API_KEY=
SUPERASSIST_DAILY_BRIEF_BASE_URL=

# --- Three-day political-theory quiz ---
# Uses the main Agent. The notebook keeps the latest calendar days and the wrong-book is persistent.
SUPERASSIST_DAILY_QUIZ_ENABLED=true
SUPERASSIST_DAILY_QUIZ_SCHEDULER_ENABLED=true
SUPERASSIST_DAILY_QUIZ_CONTEXT_ENABLED=true
SUPERASSIST_DAILY_QUIZ_TIME=17:00
SUPERASSIST_DAILY_QUIZ_QUESTION_COUNT=10
SUPERASSIST_DAILY_QUIZ_NOTEBOOK_DAYS=3

# --- LangSmith ---
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=superassist-dev

# --- WeCom intelligent robot ---
SUPERASSIST_WECOM_BOT_ID=
SUPERASSIST_WECOM_BOT_SECRET=
SUPERASSIST_WECOM_ALLOWED_USER_IDS=
SUPERASSIST_WECOM_USER_ID_MAP={}
SUPERASSIST_WECOM_RAG_MODE_DEFAULT=false
SUPERASSIST_WECOM_MAX_CONCURRENT=3
SUPERASSIST_WECOM_STREAM_INTERVAL_MS=300
SUPERASSIST_WECOM_AI_ENGINE_URL=http://127.0.0.1:8765

# --- WeCom desktop RPA (external groups only) ---
SUPERASSIST_WECOM_RPA_ALLOWED_GROUPS=
SUPERASSIST_WECOM_RPA_TRIGGER_PREFIXES=
SUPERASSIST_WECOM_RPA_POLL_INTERVAL_SECONDS=1.5
SUPERASSIST_WECOM_RPA_REPLY_MAX_CHARS=3000
