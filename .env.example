# --- Model ---
SUPERASSIST_MODEL_PROVIDER=openai
SUPERASSIST_MODEL=gpt-4o-mini
SUPERASSIST_API_KEY=
SUPERASSIST_BASE_URL=https://api.openai.com/v1
# SUPERASSIST_TEMPERATURE=
# SUPERASSIST_MAX_TOKENS=

# --- Tools ---
SUPERASSIST_ENABLE_TOOLS=false
SUPERASSIST_TOOL_NETWORK_ENABLED=true
SUPERASSIST_TOOL_SHELL_ENABLED=false
SUPERASSIST_MAX_TOOL_CALLS=8

# --- Subagents ---
SUPERASSIST_SUBAGENTS_ENABLED=true
SUPERASSIST_SUBAGENT_MAX_CONCURRENT=3
SUPERASSIST_SUBAGENT_TIMEOUT_SECONDS=900
SUPERASSIST_SUBAGENT_MAX_TURNS=20

# --- Memory ---
SUPERASSIST_MEMORY_LLM_WRITER_ENABLED=false
SUPERASSIST_MEMORY_DEBOUNCE_SECONDS=30.0
SUPERASSIST_MEMORY_TOP_K=12
SUPERASSIST_MEMORY_CANDIDATE_POOL_SIZE=150
SUPERASSIST_MEMORY_READ_USE_PPR=true
SUPERASSIST_MEMORY_READ_ENTRY_POINTS=10
SUPERASSIST_MEMORY_READ_MAX_DEPTH=3
SUPERASSIST_MEMORY_READ_BFS_WEIGHT=0.6
SUPERASSIST_MEMORY_READ_PPR_WEIGHT=0.4
SUPERASSIST_MEMORY_READ_BFS_DECAY=0.7
SUPERASSIST_MEMORY_REINFORCE_SIMILARITY=0.85
SUPERASSIST_MEMORY_CONCEPT_MERGE_SIMILARITY=0.85
SUPERASSIST_MEMORY_COMPLETION_SIMILARITY=0.30
SUPERASSIST_MEMORY_COMPLETION_TOP_K=5
SUPERASSIST_MEMORY_DECAY_LAMBDA=0.005
SUPERASSIST_MEMORY_EDGE_DELETE_THRESHOLD=0.15

# --- Short memory ---
SUPERASSIST_SHORT_MEMORY_TOKEN_LIMIT=80000
SUPERASSIST_SHORT_MEMORY_KEEP_RECENT_TURNS=30
SUPERASSIST_SHORT_MEMORY_SUMMARY_TARGET_TOKENS=6000
SUPERASSIST_SHORT_MEMORY_ENABLE_TOOL_EVENTS=true

# --- Skills ---
SUPERASSIST_SKILL_ACTIVE_TTL_SECONDS=300

# --- Embedding ---
SUPERASSIST_EMBEDDING_PROVIDER=bge
SUPERASSIST_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
SUPERASSIST_EMBEDDING_DEVICE=cpu

# --- LightRAG knowledge base ---
SUPERASSIST_RAG_MAX_FILE_SIZE_MB=25
SUPERASSIST_RAG_MAX_FILES_PER_BATCH=20
SUPERASSIST_RAG_MAX_ATTEMPTS=3
SUPERASSIST_RAG_TOP_K=20
SUPERASSIST_RAG_CHUNK_TOP_K=10
SUPERASSIST_RAG_CONTEXT_MAX_CHARS=24000

# --- Persistence ---
SUPERASSIST_DATA_DIR=.superassist
SUPERASSIST_ADMIN_USERNAMES=painting

# --- Feishu ---
SUPERASSIST_FEISHU_APP_ID=
SUPERASSIST_FEISHU_APP_SECRET=
SUPERASSIST_FEISHU_DOMAIN=https://open.feishu.cn
SUPERASSIST_FEISHU_ALLOWED_OPEN_IDS=
SUPERASSIST_FEISHU_MENTION_ONLY=true
SUPERASSIST_FEISHU_ACTIVE_SESSION_SECONDS=180

# --- WeCom intelligent robot ---
SUPERASSIST_WECOM_BOT_ID=
SUPERASSIST_WECOM_BOT_SECRET=
SUPERASSIST_WECOM_ALLOWED_USER_IDS=
SUPERASSIST_WECOM_USER_ID_MAP={}
SUPERASSIST_WECOM_RAG_MODE_DEFAULT=false
SUPERASSIST_WECOM_MAX_CONCURRENT=3
SUPERASSIST_WECOM_STREAM_INTERVAL_MS=300
SUPERASSIST_WECOM_AI_ENGINE_URL=http://127.0.0.1:8765

# --- WeCom desktop RPA (external groups only) ---
SUPERASSIST_WECOM_RPA_ALLOWED_GROUPS=
SUPERASSIST_WECOM_RPA_TRIGGER_PREFIXES=
SUPERASSIST_WECOM_RPA_POLL_INTERVAL_SECONDS=1.5
SUPERASSIST_WECOM_RPA_REPLY_MAX_CHARS=3000

# --- LangSmith ---
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=superassist-dev
