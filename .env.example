# --- Model ---
SUPERASSIST_MODEL_PROVIDER=openai
SUPERASSIST_MODEL=gpt-4o-mini
SUPERASSIST_API_KEY=
SUPERASSIST_BASE_URL=https://api.openai.com/v1
# SUPERASSIST_TEMPERATURE=
# SUPERASSIST_MAX_TOKENS=

# --- Tools ---
SUPERASSIST_ENABLE_TOOLS=false
SUPERASSIST_TOOL_NETWORK_ENABLED=true
SUPERASSIST_TOOL_SHELL_ENABLED=false
SUPERASSIST_MAX_TOOL_CALLS=8

# --- Subagents ---
SUPERASSIST_SUBAGENTS_ENABLED=true
SUPERASSIST_SUBAGENT_MAX_CONCURRENT=3
SUPERASSIST_SUBAGENT_TIMEOUT_SECONDS=900
SUPERASSIST_SUBAGENT_MAX_TURNS=20

# --- Memory ---
SUPERASSIST_MEMORY_LLM_WRITER_ENABLED=false
SUPERASSIST_MEMORY_TOP_K=12
SUPERASSIST_EMBEDDING_PROVIDER=bge
SUPERASSIST_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
SUPERASSIST_EMBEDDING_DEVICE=cpu

# --- Persistence ---
SUPERASSIST_DATA_DIR=.superassist

# --- Feishu ---
SUPERASSIST_FEISHU_APP_ID=
SUPERASSIST_FEISHU_APP_SECRET=
SUPERASSIST_FEISHU_DOMAIN=https://open.feishu.cn
SUPERASSIST_FEISHU_ALLOWED_OPEN_IDS=
SUPERASSIST_FEISHU_MENTION_ONLY=true

# --- LangSmith ---
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=superassist-dev
